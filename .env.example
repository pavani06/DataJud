# Arquivo opcional. O uso padrão não exige .env nem cópia de chave.
# auto lê a chave oficial antes de cada busca/página; não guarda chave ou HTML.
DATAJUD_AUTH_MODE=auto
# Ignorada em auto. Para override explícito, use DATAJUD_AUTH_MODE=manual
# e preencha somente o valor publicado em:
# https://datajud-wiki.cnj.jus.br/api-publica/acesso/
DATAJUD_API_KEY=
DATAJUD_TIMEOUT_SECONDS=30
DATAJUD_MAX_RETRIES=2
DATAJUD_DATA_DIR=./data
